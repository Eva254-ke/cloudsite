---
---

<section class="hero-section">
  <div class="hero-media" aria-hidden="true">
    <img
      class="hero-image"
      src="https://www.blm.gov/sites/default/files/styles/og_image/public/images/2024-03/commsite-hero_rev_0.jpg?h=d4632ca3&itok=qgQNziKx"
      alt="Satellite network infrastructure across Africa"
      loading="lazy"
    />
    <div class="hero-overlay"></div>
  </div>

  <div class="container">
    <div class="hero-content">
      <span class="hero-badge">
        <span class="hero-badge-dot" aria-hidden="true"></span>
        Satellite network infrastructure for Africa
      </span>
      <h1>
        A reliable network needs <span class="text-gradient">more than a dish on the roof.</span>
      </h1>
      <p class="hero-intro">
        CloudBridge builds and operates internet infrastructure for hospitals, institutions,
        businesses, and remote sites that cannot depend on weak terrestrial coverage alone.
      </p>

      <div class="hero-actions">
        <a href="/contact" class="btn btn-primary">Talk to our team</a>
        <a href="/#mission" class="btn btn-ghost">See how we work</a>
      </div>
    </div>

    <div class="hero-scroll-cue" aria-hidden="true">
      <span class="scroll-line"></span>
      <span class="scroll-label">Scroll</span>
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: stretch;
    overflow: hidden;
  }

  .hero-media {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: #0a1020;
  }

  .hero-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(1.14) saturate(1.05);
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(5, 7, 15, 0.45) 0%,
      rgba(5, 7, 15, 0.2) 35%,
      rgba(5, 7, 15, 0.2) 65%,
      rgba(5, 7, 15, 0.7) 100%
    );
  }

  .hero-section .container {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    width: min(calc(100% - 32px), var(--container-width));
    padding-top: 120px;
    padding-bottom: 96px;
  }

  .hero-content {
    position: relative;
    max-width: 760px;
  }

  .hero-content::before {
    content: "";
    position: absolute;
    inset: -36px -44px;
    z-index: -1;
    background: radial-gradient(150% 140% at 20% 30%, rgba(5, 7, 15, 0.65), rgba(5, 7, 15, 0) 75%);
    border-radius: 28px;
    filter: blur(8px);
    pointer-events: none;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-8);
    padding: 6px 14px;
    margin-bottom: var(--space-24);
    border: 1px solid rgba(255, 255, 255, 0.24);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    color: rgba(255, 255, 255, 0.95);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.01em;
  }

  .hero-badge-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #34d399;
    box-shadow: 0 0 0 3px rgba(52, 211, 153, 0.25);
  }

  .hero-section h1 {
    color: #fff;
    font-size: clamp(2.5rem, 7.5vw, 5rem);
    line-height: 1.02;
    letter-spacing: -0.035em;
    margin-bottom: var(--space-24);
    text-shadow: 0 2px 40px rgba(0, 0, 0, 0.9);
  }

  .hero-intro {
    color: rgba(255, 255, 255, 0.97);
    font-size: clamp(1rem, 2.4vw, 1.18rem);
    line-height: 1.65;
    max-width: 560px;
    text-shadow: 0 1px 30px rgba(0, 0, 0, 0.85);
  }

  .hero-actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-12);
    margin-top: var(--space-32);
  }

  .hero-actions .btn {
    width: 100%;
    min-height: 48px;
  }

  .btn-ghost {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: var(--space-12) var(--space-24);
    border: 1px solid rgba(255, 255, 255, 0.32);
    border-radius: var(--radius-control);
    background: transparent;
    color: #fff;
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    transition: background 200ms ease, border-color 200ms ease;
  }

  .btn-ghost:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 255, 255, 0.55);
  }

  /* Scroll indicator */
  .hero-scroll-cue {
    position: absolute;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-8);
    animation: float-cue 2.5s ease-in-out infinite;
  }

  .scroll-line {
    display: block;
    width: 1px;
    height: 36px;
    background: linear-gradient(180deg, transparent, rgba(255, 255, 255, 0.5));
  }

  .scroll-label {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.5);
  }

  @keyframes float-cue {
    0%, 100% { transform: translateX(-50%) translateY(0); }
    50% { transform: translateX(-50%) translateY(8px); }
  }

  @media (max-width: 420px) {
    .hero-section .container {
      padding-top: 104px;
      padding-bottom: 84px;
    }
  }
</style>
