---
import CookieBanner from '../components/CookieBanner.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
  canonical?: string;
  noIndex?: boolean;
}

const {
  title,
  description,
  image = '/favicon.svg',
  canonical,
  noIndex = false,
} = Astro.props;

const siteUrl = 'https://cloudbridge.network';
const currentUrl = canonical || Astro.url.href;
const imageUrl = new URL(image, siteUrl).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | CloudBridge Networks</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noIndex ? 'noindex, nofollow' : 'index, follow'} />
    <link rel="canonical" href={currentUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={currentUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:site_name" content="CloudBridge Networks" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/logo.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="page-shell">
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
    <CookieBanner />

    <script>
      // Scroll-reveal: elements with [data-reveal] fade/slide in when they enter the viewport
      const revealElements = document.querySelectorAll('[data-reveal]');
      if (revealElements.length && 'IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
        );
        revealElements.forEach((el) => observer.observe(el));
      } else {
        // Fallback: show everything
        revealElements.forEach((el) => el.classList.add('is-visible'));
      }

      // Smooth scroll for anchor links
      document.querySelectorAll('a[href^="/#"]').forEach((anchor) => {
        anchor.addEventListener('click', (e) => {
          const href = anchor.getAttribute('href');
          if (!href) return;
          const hash = href.replace('/', '');
          const target = document.querySelector(hash);
          if (target) {
            e.preventDefault();
            target.scrollIntoView({ behavior: 'smooth', block: 'start' });
            window.history.pushState(null, '', hash);
          }
        });
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    --color-background: #ffffff;
    --color-surface: transparent;
    --color-surface-strong: #f8fafc;
    --color-section-tint: #eef2ff;
    --color-text: #0f172a;
    --color-muted: #475569;
    --color-subtle: #94a3b8;
    --color-border: #e2e8f0;
    --color-border-strong: #cbd5e1;

    --color-brand: #4f46e5;
    --color-brand-strong: #4338ca;
    --color-accent: #0ea5e9;
    --brand-gradient: linear-gradient(135deg, #4f46e5 0%, #6366f1 45%, #0ea5e9 100%);
    --brand-gradient-soft: linear-gradient(135deg, rgba(79, 70, 229, 0.05), rgba(14, 165, 233, 0.05));

    --container-width: 1240px;
    --space-4: 4px;
    --space-8: 8px;
    --space-12: 12px;
    --space-16: 16px;
    --space-20: 20px;
    --space-24: 24px;
    --space-32: 32px;
    --space-48: 48px;
    --space-64: 64px;
    --space-96: 96px;

    --radius-control: 10px;
    --radius-card: 16px;
    --radius-lg: 24px;

    --shadow-sm: 0 1px 2px rgba(15, 23, 42, 0.06);
    --shadow-md: 0 12px 30px -14px rgba(15, 23, 42, 0.16);
    --shadow-lg: 0 26px 60px -22px rgba(79, 70, 229, 0.28);
    --shadow-glow: 0 18px 50px -18px rgba(79, 70, 229, 0.55);

    --font-body: 'Inter', system-ui, sans-serif;
    --font-display: 'Plus Jakarta Sans', 'Inter', system-ui, sans-serif;

    color-scheme: light;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    font-family: var(--font-body);
    font-size: 16px;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    scroll-behavior: smooth;
    background: var(--color-background);
  }

  body {
    min-height: 100vh;
    background: var(--color-background);
    color: var(--color-text);
    line-height: 1.5;
    text-wrap: pretty;
    position: relative;
    overflow-x: hidden;
  }

  body::before {
    content: '';
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(52% 42% at 8% -4%, rgba(79, 70, 229, 0.16), transparent 60%),
      radial-gradient(46% 40% at 100% 6%, rgba(6, 182, 212, 0.14), transparent 62%),
      radial-gradient(48% 45% at 50% 108%, rgba(79, 70, 229, 0.1), transparent 60%);
  }

  .page-shell {
    animation: page-fade 300ms ease-out;
  }

  img,
  svg,
  picture {
    display: block;
    max-width: 100%;
  }

  a {
    color: inherit;
  }

  button,
  input,
  select,
  textarea {
    font: inherit;
    color: inherit;
  }

  main {
    display: block;
  }

  section {
    padding: var(--space-64) 0;
    scroll-margin-top: 92px;
  }

  [id] {
    scroll-margin-top: 92px;
  }

  .section-surface {
    background: var(--color-surface);
  }

  .section-surface-strong {
    background: var(--color-surface-strong);
  }

  section + section {
    border-top: 1px solid var(--color-border);
  }

  h1,
  h2,
  h3 {
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.05;
    color: var(--color-text);
  }

  h1 {
    font-size: clamp(3rem, 8vw, 6rem);
  }

  h2 {
    font-size: clamp(2rem, 4vw, 3.5rem);
  }

  h3 {
    font-size: 1.5rem;
  }

  p,
  li,
  dd {
    color: var(--color-muted);
  }

  ul,
  ol {
    padding-left: var(--space-24);
  }

  strong {
    color: var(--color-text);
  }

  .container {
    width: min(calc(100% - 32px), var(--container-width));
    margin: 0 auto;
  }

  .card {
    border: none;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
    transition: none;
  }

  .card:hover {
    box-shadow: none;
    border-color: transparent;
    transform: none;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-8);
    min-height: 46px;
    padding: var(--space-12) var(--space-16);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-control);
    background: transparent;
    color: var(--color-text);
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    transition:
      transform 200ms ease,
      box-shadow 200ms ease,
      background 200ms ease,
      border-color 200ms ease,
      opacity 200ms ease;
  }

  .btn-primary {
    border: 0;
    background: var(--brand-gradient);
    color: #ffffff;
    box-shadow: var(--shadow-md);
  }

  .btn-primary:hover,
  .btn-primary:focus-visible {
    transform: translateY(-1px);
    box-shadow: 0 22px 56px -18px rgba(79, 70, 229, 0.65);
  }

  .btn-secondary:hover,
  .btn-secondary:focus-visible {
    background: var(--color-surface-strong);
    transform: translateY(-1px);
  }

  .btn-block {
    width: 100%;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--space-8);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-subtle);
  }

  .eyebrow::before {
    content: '';
    width: 22px;
    height: 2px;
    border-radius: 2px;
    background: var(--brand-gradient);
  }

  .text-gradient {
    background: var(--brand-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .section-heading,
  .page-heading {
    max-width: 860px;
  }

  .section-heading {
    margin-bottom: var(--space-32);
  }

  .page-heading {
    margin-bottom: var(--space-32);
  }

  .section-heading .eyebrow,
  .page-heading .eyebrow {
    margin-bottom: var(--space-12);
  }

  .section-heading h2,
  .page-heading h1 {
    margin-bottom: var(--space-16);
  }

  .section-heading p,
  .page-heading p {
    max-width: 720px;
  }

  .skip-link {
    position: absolute;
    left: -9999px;
    top: var(--space-16);
    z-index: 100;
    padding: var(--space-12) var(--space-16);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-control);
    background: var(--color-surface);
    text-decoration: none;
  }

  .skip-link:focus {
    left: var(--space-16);
  }

  label {
    display: block;
    margin-bottom: var(--space-8);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text);
  }

  input,
  select,
  textarea {
    width: 100%;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-control);
    background: var(--color-surface);
    padding: var(--space-12);
  }

  input::placeholder,
  textarea::placeholder {
    color: var(--color-subtle);
  }

  .media-frame {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    overflow: hidden;
    background: var(--color-background);
  }

  img[loading='lazy'] {
    content-visibility: auto;
  }

  :focus-visible {
    outline: 2px solid var(--color-brand);
    outline-offset: 2px;
  }

  @keyframes page-fade {
    from {
      opacity: 0;
    }

    to {
      opacity: 1;
    }
  }

  @keyframes float-orb {
    0%,
    100% {
      transform: translate3d(0, 0, 0);
    }

    50% {
      transform: translate3d(0, -22px, 0);
    }
  }

  /* Scroll reveal */
  .js-anim [data-reveal] {
    opacity: 0;
    transform: translateY(18px);
    transition:
      opacity 650ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 650ms cubic-bezier(0.22, 1, 0.36, 1);
    will-change: opacity, transform;
  }

  .js-anim [data-reveal].in-view {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }

    .page-shell {
      animation: none;
    }

    .js-anim [data-reveal] {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --color-background: #080c14;
      --color-surface: transparent;
      --color-surface-strong: #111827;
      --color-section-tint: #161a33;
      --color-text: #f8fafc;
      --color-muted: #94a3b8;
      --color-subtle: #475569;
      --color-border: #1f2937;
      --color-border-strong: #374151;
      --color-brand: #818cf8;
      --color-accent: #38bdf8;
      --brand-gradient: linear-gradient(135deg, #818cf8 0%, #6366f1 45%, #38bdf8 100%);
      --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.4);
      --shadow-md: 0 12px 30px -14px rgba(0, 0, 0, 0.55);
      --shadow-lg: 0 26px 60px -22px rgba(99, 102, 241, 0.4);
      --shadow-glow: 0 18px 50px -18px rgba(99, 102, 241, 0.5);
      color-scheme: dark;
    }

    body::before {
      background:
        radial-gradient(52% 42% at 8% -4%, rgba(99, 102, 241, 0.12), transparent 60%),
        radial-gradient(46% 40% at 100% 6%, rgba(56, 189, 248, 0.08), transparent 62%),
        radial-gradient(48% 45% at 50% 108%, rgba(99, 102, 241, 0.06), transparent 60%);
    }

    .card {
      background: transparent;
    }
  }

  @media (max-width: 767px) {
    section {
      padding: var(--space-48) 0;
    }
  }

  /* ===== Shared media utilities ===== */
  .media-figure {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-card);
    background: var(--color-surface-strong);
    box-shadow: var(--shadow-md);
  }

  .media-figure img,
  .media-figure video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .media-figure.is-wide {
    aspect-ratio: 16 / 10;
  }

  .media-figure.is-tall {
    aspect-ratio: 4 / 5;
  }

  .media-figure.is-square {
    aspect-ratio: 1 / 1;
  }

  .media-figure img {
    transition: transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .media-figure:hover img {
    transform: scale(1.04);
  }

  .video-frame {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: #05070f;
    box-shadow: var(--shadow-lg);
    aspect-ratio: 16 / 9;
  }

  .video-frame video,
  .video-frame img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .play-button {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    display: inline-flex;
    align-items: center;
    gap: var(--space-8);
    padding: var(--space-12) var(--space-24);
    border: 0;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.94);
    color: #0b1020;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
    box-shadow: var(--shadow-lg);
    transition: transform 200ms ease;
  }

  .play-button:hover,
  .play-button:focus-visible {
    transform: translate(-50%, -50%) scale(1.05);
  }

  .play-button .play-icon {
    width: 0;
    height: 0;
    border-style: solid;
    border-width: 7px 0 7px 12px;
    border-color: transparent transparent transparent #4f46e5;
  }

  .inline-play {
    display: inline-flex;
    align-items: center;
    gap: var(--space-8);
  }

  .inline-play .play-icon {
    width: 0;
    height: 0;
    border-style: solid;
    border-width: 6px 0 6px 10px;
    border-color: transparent transparent transparent currentColor;
  }

  .avatar {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
    box-shadow: var(--shadow-sm);
    border: 2px solid var(--color-surface);
  }

  /* Stats band */
  .stats-band {
    display: grid;
    gap: var(--space-24);
    background: var(--brand-gradient);
    color: #fff;
    border-radius: var(--radius-lg);
    padding: var(--space-32);
    box-shadow: var(--shadow-md);
  }

  .stat .stat-value {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .stat .stat-label {
    opacity: 0.92;
    font-size: 0.95rem;
    margin-top: var(--space-8);
    color: #fff;
  }

  @media (min-width: 760px) {
    .stats-band {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  /* Testimonials */
  .testimonial-card {
    display: grid;
    gap: var(--space-16);
    padding: var(--space-24);
    background: var(--color-surface);
  }

  .testimonial-quote {
    color: var(--color-text);
    font-size: 1.05rem;
    line-height: 1.6;
  }

  .testimonial-person {
    display: flex;
    align-items: center;
    gap: var(--space-12);
  }

  .testimonial-name {
    font-weight: 700;
    color: var(--color-text);
  }

  .testimonial-role {
    color: var(--color-subtle);
    font-size: 0.85rem;
  }

  .stars {
    color: #f5b50a;
    letter-spacing: 2px;
  }

  /* News / insights */
  .news-grid {
    display: grid;
    gap: var(--space-16);
  }

  .news-card {
    display: grid;
    gap: var(--space-12);
    padding: var(--space-16);
    background: var(--color-surface);
    transition:
      transform 240ms ease,
      box-shadow 240ms ease;
  }

  .news-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }

  .news-media {
    aspect-ratio: 16 / 10;
    border-radius: var(--radius-control);
    overflow: hidden;
  }

  .news-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .news-card h3 {
    font-size: 1.1rem;
  }

  .news-tag {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  @media (min-width: 760px) {
    .news-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1100px) {
    .news-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>

<script>
  const root = document.documentElement;
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!prefersReduced) {
    root.classList.add('js-anim');

    const selector = [
      '.section-heading',
      '.hero-copy',
      '.hero-panel',
      '.mission-card',
      '.mission-visual',
      '.capability-card',
      '.build-step',
      '.infrastructure-visual',
      '.focus-card',
      '.approach-card',
      '.approach-visual',
      '.closing-card',
      '.about-card',
      '.principle-card',
      '.facts-card',
      '.about-cta',
      '.hero-stage',
    ].join(',');

    const targets = Array.from(document.querySelectorAll(selector));

    targets.forEach((el) => {
      el.setAttribute('data-reveal', '');
      const parent = el.parentElement;
      if (parent) {
        const siblings = Array.from(parent.children).filter((c) =>
          c.hasAttribute('data-reveal')
        );
        const index = siblings.indexOf(el);
        const delay = Math.min(index, 6) * 70;
        (el as HTMLElement).style.transitionDelay = `${delay}ms`;
      }
    });

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('in-view');
              observer.unobserve(entry.target);
            }
          });
        },
        { rootMargin: '0px 0px -8% 0px', threshold: 0.08 }
      );

      targets.forEach((el) => observer.observe(el));
    } else {
      targets.forEach((el) => el.classList.add('in-view'));
    }
  }
</script>
