---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Partner With Us"
  description="CloudBridge is operating now. Use this page if you came through an older waitlist link and want to discuss an African network infrastructure project."
  canonical="https://cloudbridge.network/join-waitlist"
>
  <Header />

  <main id="main">
    <section class="partner-section">
      <div class="container">
        <div class="page-heading">
          <p class="eyebrow">Partner with us</p>
          <h1>CloudBridge is already operating.</h1>
          <p>
            This page stays live for older waitlist links. If you need satellite-based network
            infrastructure, billing support, or managed operations, send us the site details.
          </p>
        </div>

        <div class="partner-grid">
          <article class="partner-item">
            <p class="partner-index">01</p>
            <h2>Infrastructure projects</h2>
            <p>Connectivity planning for hospitals, institutions, businesses, and critical facilities.</p>
          </article>

          <article class="partner-item">
            <p class="partner-index">02</p>
            <h2>Remote deployments</h2>
            <p>Satellite-backed internet for sites where terrestrial options are weak or unavailable.</p>
          </article>

          <article class="partner-item">
            <p class="partner-index">03</p>
            <h2>Billing and operations</h2>
            <p>Support for access control, billing workflows, and the operating layer after rollout.</p>
          </article>
        </div>

        <div class="partner-cta-block">
          <div class="partner-cta-copy">
            <p class="eyebrow">Start here</p>
            <h2>Use the contact page to send the project details.</h2>
            <p>We can follow up on scope, site conditions, and the infrastructure or operations problem you need solved.</p>
          </div>

          <div class="partner-actions">
            <a href="/contact" class="btn btn-primary">Contact the team</a>
            <a href="/" class="btn btn-secondary">Back to home</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .page-heading {
    max-width: 680px;
    margin-bottom: var(--space-48);
  }

  .page-heading h1 {
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 1.08;
    margin-bottom: var(--space-16);
  }

  .page-heading p {
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--color-muted);
  }

  .partner-grid {
    display: grid;
    gap: var(--space-32);
    margin-bottom: var(--space-96);
  }

  .partner-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
    padding-top: var(--space-16);
    border-top: 1px solid var(--color-border);
  }

  .partner-index {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--color-accent);
  }

  .partner-item h2 {
    font-size: 1.25rem;
    letter-spacing: -0.02em;
  }

  .partner-item p {
    color: var(--color-muted);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .partner-cta-block {
    display: grid;
    gap: var(--space-32);
    padding-top: var(--space-48);
    border-top: 1px solid var(--color-border-strong);
  }

  .partner-cta-copy h2 {
    font-size: clamp(1.75rem, 3.5vw, 2.75rem);
    line-height: 1.1;
    margin-bottom: var(--space-16);
  }

  .partner-cta-copy p {
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--color-muted);
    max-width: 680px;
  }

  .partner-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-12);
  }

  @media (min-width: 760px) {
    .partner-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 900px) {
    .partner-cta-block {
      grid-template-columns: 1.3fr 0.7fr;
      align-items: center;
      gap: var(--space-48);
    }

    .partner-actions {
      justify-content: flex-end;
    }
  }
</style>
