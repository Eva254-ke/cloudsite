---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="About"
  description="CloudBridge Networks builds Africa's satellite-based network infrastructure for hospitals, institutions, businesses, and remote sites."
  canonical="https://cloudbridge.network/about"
>
  <Header />

  <main id="main">
    <section class="about-hero-section">
      <div class="container">
        <div class="page-heading">
          <p class="eyebrow">About CloudBridge</p>
          <h1>We build the satellite-backed networks that keep important sites online.</h1>
          <p>
            CloudBridge started from a practical need: too many important sites across Africa still
            work with weak connectivity, unstable links, or no realistic terrestrial option at all.
          </p>
        </div>

        <div class="about-grid">
          <article class="about-intro-pane">
            <h2>What the company is built to do</h2>
            <p>
              We focus on satellite-backed internet infrastructure for hospitals, institutions,
              businesses, community sites, and remote facilities where stable connectivity directly affects daily work.
            </p>
            <p>
              That means planning beyond a basic install. We think through site conditions,
              internal distribution, resilience, billing requirements, and the support needed after a site goes live.
            </p>
          </article>

          <div class="about-image-pane">
            <img
              src="https://images.unsplash.com/photo-1573164713714-d95e436ab8d6?w=800&q=80&auto=format&fit=crop"
              alt="CloudBridge collaborative team planning network rollout in office"
              class="about-main-image"
              loading="lazy"
            />
          </div>

          <aside class="facts-pane">
            <h2>Company facts</h2>
            <dl class="facts-list">
              <div class="fact-row">
                <dt>Headquarters</dt>
                <dd>Nairobi, Kenya</dd>
              </div>
              <div class="fact-row">
                <dt>Founded</dt>
                <dd>2024</dd>
              </div>
              <div class="fact-row">
                <dt>Registration</dt>
                <dd>BN-Y6S98MJB</dd>
              </div>
              <div class="fact-row">
                <dt>Focus</dt>
                <dd>Satellite infrastructure, billing systems, and managed network operations</dd>
              </div>
            </dl>
          </aside>
        </div>
      </div>
    </section>

    <section class="principles-section">
      <div class="container">
        <div class="section-heading">
          <p class="eyebrow">How we work</p>
          <h2>We keep the work direct.</h2>
          <p>Projects are shaped by site conditions, operational risk, and long-term usability.</p>
        </div>

        <div class="principles-grid">
          <article class="principle-item">
            <p class="principle-index">01</p>
            <h3>Plan around uptime</h3>
            <p>For hospitals, institutions, and businesses, reliable connectivity is part of how the site functions.</p>
          </article>

          <article class="principle-item">
            <p class="principle-index">02</p>
            <h3>Build for remote realities</h3>
            <p>We account for access limits, maintenance windows, and the practical constraints of underserved areas.</p>
          </article>

          <article class="principle-item">
            <p class="principle-index">03</p>
            <h3>Stay involved after launch</h3>
            <p>Support matters after deployment, not only during installation week.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="about-cta-section">
      <div class="container">
        <div class="about-cta-block">
          <div class="about-cta-copy">
            <p class="eyebrow">Work with us</p>
            <h2>Need a site or network project reviewed?</h2>
            <p>Share the site details and we can talk through the infrastructure, billing, and operational needs.</p>
          </div>
          <a href="/contact" class="btn btn-primary">Contact CloudBridge</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .page-heading {
    max-width: 760px;
    margin-bottom: var(--space-48);
  }

  .page-heading h1 {
    max-width: 700px;
    font-size: clamp(2.25rem, 5vw, 3.8rem);
    line-height: 1.05;
    margin-bottom: var(--space-16);
  }

  .page-heading p:last-child {
    max-width: 620px;
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--color-muted);
  }

  .about-grid {
    display: grid;
    gap: var(--space-48);
  }

  .about-intro-pane h2,
  .facts-pane h2 {
    margin-bottom: var(--space-16);
    font-size: 1.5rem;
    letter-spacing: -0.02em;
  }

  .about-intro-pane p {
    color: var(--color-muted);
    font-size: 0.98rem;
    line-height: 1.6;
  }

  .about-intro-pane p + p {
    margin-top: var(--space-16);
  }

  .about-image-pane {
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--color-surface-strong);
  }

  .about-main-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .facts-list {
    margin-top: var(--space-16);
  }

  .fact-row {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-12) 0;
    border-top: 1px solid var(--color-border);
  }

  .fact-row:first-child {
    padding-top: 0;
    border-top: 0;
  }

  .fact-row dt {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .fact-row dd {
    color: var(--color-text);
    font-size: 0.95rem;
  }

  /* Principles section */
  .principles-section {
    padding-top: var(--space-96);
    padding-bottom: var(--space-96);
    border-top: 1px solid var(--color-border);
  }

  .principles-grid {
    display: grid;
    gap: var(--space-32);
  }

  .principle-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
    padding-top: var(--space-16);
    border-top: 1px solid var(--color-border);
  }

  .principle-index {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--color-accent);
  }

  .principle-item h3 {
    font-size: 1.25rem;
    letter-spacing: -0.02em;
  }

  .principle-item p {
    color: var(--color-muted);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  /* CTA Block */
  .about-cta-section {
    padding-top: var(--space-96);
    padding-bottom: var(--space-96);
    border-top: 1px solid var(--color-border);
  }

  .about-cta-block {
    display: grid;
    gap: var(--space-32);
    padding-top: var(--space-48);
    border-top: 1px solid var(--color-border-strong);
  }

  .about-cta-copy h2 {
    font-size: clamp(1.75rem, 3.5vw, 2.75rem);
    line-height: 1.1;
    margin-bottom: var(--space-16);
  }

  .about-cta-copy p {
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--color-muted);
    max-width: 680px;
  }

  @media (min-width: 760px) {
    .principles-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 900px) {
    .about-grid {
      grid-template-columns: 1fr 1fr 1fr;
      gap: var(--space-32);
    }

    .about-cta-block {
      grid-template-columns: 1.3fr 0.7fr;
      align-items: center;
      gap: var(--space-48);
    }

    .about-cta-block a {
      justify-self: end;
    }
  }

  @media (max-width: 767px) {
    .page-heading h1 {
      font-size: clamp(2rem, 10vw, 2.8rem);
    }
  }
</style>
